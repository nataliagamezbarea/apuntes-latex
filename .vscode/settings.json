{
  // ===================================================================
  //  LaTeX Workshop — compilar SIEMPRE igual:
  //    * XeLaTeX (fuentes del sistema, emojis y acentos)
  //    * -shell-escape (imprescindible: \imagen, \inputcarpeta y la
  //      descarga de la libreria lo necesitan)
  //    * dos pasadas, para que los indices y las referencias queden bien
  // ===================================================================
  "files.associations": {
    "*.tex": "latex",
    "*.ltx": "latex"
  },
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggestOnTriggerCharacters": true,
  "latex-workshop.latex.magic.args": [
    "-synctex=1",
    "-interaction=nonstopmode",
    "-file-line-error",
    "-shell-escape",
    "%DOC%"
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-shell-escape",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex (shell-escape) x2",
      "tools": ["xelatex", "xelatex"]
    },
    {
      "name": "xelatex (shell-escape)",
      "tools": ["xelatex"]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",

  // Los comandos de la libreria, como sugerencias de LaTeX Workshop.
  // Los genera .vscode/generar_sugerencias.py (no lo edites a mano).
  "latex-workshop.intellisense.command.user": {
    "\\alertaicon": "\\alertaicon",
    "\\alertas": "\\alertas{$1}",
    "\\caja": "\\caja{{$1}{$2}}",
    "\\cajadual": "\\cajadual{{$1}{$2}{$3}}",
    "\\casillaicon": "\\casillaicon",
    "\\closingbars": "\\closingbars",
