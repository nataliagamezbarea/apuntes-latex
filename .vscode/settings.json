    "\\definicionpar": "\\definicionpar{{$1}{$2}{$3}}",
    "\\diamanteicon": "\\diamanteicon",
    "\\estrellaicon": "\\estrellaicon",
    "\\estrellas": "\\estrellas{$1}",
    "\\fichaitem": "\\fichaitem{{$1}{$2}}",
