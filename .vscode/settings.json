{
  // ===== Configuración LaTeX Workshop (VS Code) para la plantilla de apuntes =====

  // Herramienta: script propio que lee la ruta de salida desde el .tex
  "latex-workshop.latex.tools": [
    {
      "name": "compilar-apuntes",
      "command": "/home/natalia/Escritorio/APUNTES/compilar.sh",
      "args": ["%DOC%"],
      "env": {
        "TEXINPUTS": ".:/home/natalia/Escritorio/APUNTES//:"
      }
    }
  ],

  // Receta por defecto: compila con el script de apuntes
  "latex-workshop.latex.recipes": [
    {
      "name": "Apuntes (XeLaTeX)",
      "tools": ["compilar-apuntes"]
    }
  ],

  // El PDF queda junto al .tex y el script borra los auxiliares por su cuenta
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.autoClean.run": "never",

  // Compilar automáticamente al guardar
  "latex-workshop.latex.autoBuild.run": "onSave",

  // Visor PDF interno con SyncTeX (clic en el PDF -> salta al código y viceversa)
  "latex-workshop.view.pdf.viewer": "tab",

  // Limpiar archivos auxiliares: usa la receta de latexmk
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.log", "*.out", "*.toc", "*.fls",
    "*.fdb_latexmk", "*.xdv", "*.bbl", "*.blg"
  ],

  // Mostrar el PDF automáticamente al compilar
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click"
}
